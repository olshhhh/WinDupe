<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WinDupe — Buscador y Limpiador de Duplicados"
    Width="1300"
    Height="840"
    MinWidth="1040"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    Background="#0B0F17"
    Foreground="#F8FAFC"
    FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBaseBrush" Color="#0B0F17" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#121826" />
        <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#182235" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1E293B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="AccentDeepBrush" Color="#0284C7" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#182235" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#2A3950" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#223049" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#121A2A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#38BDF8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#0369A1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#075985" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#F87171" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#B91C1C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#991B1B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterSegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#1E293B" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SegmentBorder" Property="Background" Value="#0284C7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="Background" Value="#121826" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="#1E2D45" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="#0284C7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#0B0F17" />
            <Setter Property="BorderBrush" Value="#26334A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="#0B0F17"
                                                BorderBrush="#26334A"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="10,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Content="{TemplateBinding Content}"
                                                                  Margin="0,0,8,0"
                                                                  VerticalAlignment="Center" />
                                                <Path Grid.Column="1"
                                                      Data="M 0,0 L 4,4 L 8,0"
                                                      Stroke="#94A3B8"
                                                      StrokeThickness="1.6"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#38BDF8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,6,26,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,3,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        Background="#121826"
                                        BorderBrush="#2A3950"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <Border x:Name="Box"
                                    Width="18"
                                    Height="18"
                                    CornerRadius="4"
                                    Background="#0F172A"
                                    BorderBrush="#475569"
                                    BorderThickness="1.5">
                                <Path x:Name="CheckMark"
                                      Data="M 3,8.5 L 7,12.5 L 14,4.5"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#EF4444" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#F87171" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#1A2436"
                                BorderThickness="0,0,0,1"
                                Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#172234" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E2D45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ROW 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="8" Background="#12233A" BorderBrush="#1E3A5F" BorderThickness="1" Margin="0,0,12,0">
                    <Viewbox Width="22" Height="22">
                        <Canvas Width="24" Height="24">
                            <Path Data="M4,4 H14 V14 H4 Z" Stroke="#38BDF8" StrokeThickness="2" Fill="Transparent" />
                            <Path Data="M10,10 H20 V20 H10 Z" Stroke="#10B981" StrokeThickness="2" Fill="#0B0F17" />
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WinDupe" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" />
                        <Border Background="#0E293B" BorderBrush="#1E4B6B" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="10,2,0,2" VerticalAlignment="Center">
                            <TextBlock Text="SIN UAC · PAPELERA SEGURA · ONEDRIVE SAFE" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Motor C# de 3 fases (Tamano -&gt; 16 KB -&gt; SHA-256) · F5 Escanear · Esc Cancelar" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnOpenLogs" Style="{StaticResource SecondaryButtonStyle}" Content="Abrir Logs de Auditoria" />
            </StackPanel>
        </Grid>

        <!-- ROW 1: Selector de carpeta + Filtro + Tamano minimo + Boton Escanear -->
        <Border Grid.Row="1" Background="#121826" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnDownloads" Style="{StaticResource SecondaryButtonStyle}" Content="Descargas" Margin="0,0,6,0" />
                        <Button x:Name="BtnDocuments" Style="{StaticResource SecondaryButtonStyle}" Content="Documentos" Margin="0,0,6,0" />
                        <Button x:Name="BtnPictures" Style="{StaticResource SecondaryButtonStyle}" Content="Imagenes" Margin="0,0,6,0" />
                        <Button x:Name="BtnBrowse" Style="{StaticResource SecondaryButtonStyle}" Content="Personalizada..." Margin="0,0,10,0" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="#0B0F17" BorderBrush="#26334A" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <TextBox x:Name="TxtScanPath"
                                 Background="Transparent"
                                 Foreground="#F8FAFC"
                                 CaretBrush="#38BDF8"
                                 BorderThickness="0"
                                 FontSize="13"
                                 VerticalContentAlignment="Center" />
                    </Border>

                    <Button x:Name="BtnScan" Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="Escanear duplicados" MinWidth="175" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Tipo:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" />

                    <Border Grid.Column="1" Background="#0B0F17" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FilterAll" GroupName="CategoryFilter" Style="{StaticResource FilterSegmentStyle}" Content="Todos" IsChecked="True" Tag="All" Margin="0,0,2,0" />
                            <RadioButton x:Name="FilterImages" GroupName="CategoryFilter" Style="{StaticResource FilterSegmentStyle}" Content="Imagenes" Tag="Images" Margin="0,0,2,0" />
                            <RadioButton x:Name="FilterVideos" GroupName="CategoryFilter" Style="{StaticResource FilterSegmentStyle}" Content="Videos" Tag="Videos" Margin="0,0,2,0" />
                            <RadioButton x:Name="FilterDocuments" GroupName="CategoryFilter" Style="{StaticResource FilterSegmentStyle}" Content="Documentos" Tag="Documents" Margin="0,0,2,0" />
                            <RadioButton x:Name="FilterAudio" GroupName="CategoryFilter" Style="{StaticResource FilterSegmentStyle}" Content="Audio" Tag="Audio" />
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Column="2" Text="Tamano minimo:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="14,0,8,0" />

                    <ComboBox x:Name="CmbMinSize" Grid.Column="3" Style="{StaticResource DarkComboBoxStyle}" SelectedIndex="0" MinWidth="145">
                        <ComboBoxItem Content="Todos (&gt; 0 B)" Tag="1" />
                        <ComboBoxItem Content="&gt; 100 KB" Tag="102400" />
                        <ComboBoxItem Content="&gt; 1 MB" Tag="1048576" />
                        <ComboBoxItem Content="&gt; 10 MB" Tag="10485760" />
                        <ComboBoxItem Content="&gt; 100 MB" Tag="104857600" />
                    </ComboBox>
                </Grid>
            </Grid>
        </Border>

        <!-- ROW 2: KPI Cards & Live Phase Progress -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#121826" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ARCHIVOS ANALIZADOS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="TxtKpiScanned" Text="0" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,2" />
                        <TextBlock x:Name="TxtKpiFunnel" Text="Listo para escanear" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#121826" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="GRUPOS DUPLICADOS" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="TxtKpiGroups" Text="0" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,2" />
                        <TextBlock x:Name="TxtKpiFiles" Text="0 archivos en grupos" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#121826" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="SELECCIONADOS (PAPELERA)" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="TxtKpiSelected" Text="0" FontSize="20" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,2" />
                        <TextBlock x:Name="TxtKpiSelectedBytes" Text="0 B por liberar" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#121826" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock Text="ESPACIO RECUPERABLE TOTAL" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="TxtKpiReclaimable" Text="0 B" FontSize="20" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,2" />
                        <TextBlock x:Name="TxtKpiElapsed" Text="Tiempo: --" FontSize="11" Foreground="#94A3B8" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="1" Background="#121826" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtPhaseStatus" Grid.Row="0" Grid.Column="0" Text="Selecciona una carpeta y presiona Escanear duplicados." FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5" />
                    <TextBlock x:Name="TxtProgressPct" Grid.Row="0" Grid.Column="1" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="10,0,0,5" />
                    <ProgressBar x:Name="ProgressScan" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="6" Minimum="0" Maximum="100" Value="0" Background="#0B0F17" Foreground="#38BDF8" BorderThickness="0" />
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 3: Smart Selection + Search Toolbar -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnKeepOldest" Style="{StaticResource SecondaryButtonStyle}" Content="Conservar mas antiguo" IsEnabled="False" Margin="0,0,6,0" />
                <Button x:Name="BtnKeepNewest" Style="{StaticResource SecondaryButtonStyle}" Content="Conservar mas reciente" IsEnabled="False" Margin="0,0,6,0" />
                <Button x:Name="BtnAutoSelect" Style="{StaticResource SecondaryButtonStyle}" Content="Seleccion automatica" IsEnabled="False" Margin="0,0,6,0" />
                <Button x:Name="BtnClearSelection" Style="{StaticResource SecondaryButtonStyle}" Content="Deseleccionar" IsEnabled="False" Margin="0,0,10,0" />
            </StackPanel>

            <Border Grid.Column="1" Background="#121826" BorderBrush="#26334A" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSearchFilter"
                             Grid.Column="0"
                             Background="Transparent"
                             Foreground="#F8FAFC"
                             CaretBrush="#38BDF8"
                             BorderThickness="0"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             ToolTip="Filtrar resultados por nombre o ruta de carpeta" />
                    <TextBlock x:Name="TxtSearchPlaceholder"
                               Grid.Column="0"
                               Text="Filtrar resultados por nombre o ruta..."
                               Foreground="#64748B"
                               FontSize="12"
                               IsHitTestVisible="False"
                               VerticalAlignment="Center" />
                    <Button x:Name="BtnClearSearch"
                            Grid.Column="1"
                            Content="X"
                            Background="Transparent"
                            Foreground="#94A3B8"
                            BorderThickness="0"
                            FontSize="11"
                            FontWeight="Bold"
                            Padding="6,0"
                            Cursor="Hand"
                            Visibility="Collapsed" />
                </Grid>
            </Border>

            <Button x:Name="BtnSendToRecycle" Grid.Column="2" Style="{StaticResource DangerButtonStyle}" Content="Enviar a Papelera (0)" IsEnabled="False" />
        </Grid>

        <!-- ROW 4: Main Split View (Grouped List + Preview Inspector) -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- Left: Duplicate Groups List -->
            <Border Grid.Column="0" Background="#121826" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <TextBlock x:Name="TxtEmptyListHint"
                               Text="No hay resultados mostrados aun.&#x0a;Ejecuta un escaneo para detectar archivos duplicados exactos."
                               Foreground="#64748B"
                               FontSize="13.5"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <ListBox x:Name="LstDuplicates"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#F8FAFC"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             Visibility="Collapsed">
                        <ListBox.ContextMenu>
                            <ContextMenu Background="#121826" Foreground="#F8FAFC" BorderBrush="#2A3950">
                                <MenuItem x:Name="MenuMarkFolderDuplicates" Header="Marcar copias en esta carpeta (conservando copia externa)" />
                                <MenuItem x:Name="MenuKeepThis" Header="Conservar este archivo (desmarcar)" />
                                <Separator />
                                <MenuItem x:Name="MenuOpenFolder" Header="Abrir ubicacion en Explorador" />
                            </ContextMenu>
                        </ListBox.ContextMenu>

                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#162032" BorderBrush="#26344D" BorderThickness="0,1,0,1" Padding="12,7" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="125" />
                                        <ColumnDefinition Width="85" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              Style="{StaticResource DarkCheckBoxStyle}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Margin="4,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DirectoryName}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding LastWriteTimeStr}" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding SizeHuman}" FontSize="12" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />

                                    <Border Grid.Column="4" Background="#0F172A" BorderBrush="#26334A" BorderThickness="1" CornerRadius="4" Padding="6,3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="Bold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: File Preview & Metadata Inspector -->
            <Border Grid.Column="2" Background="#121826" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <TextBlock x:Name="TxtPreviewEmpty"
                               Text="Selecciona un archivo de la lista para ver su vista previa, ruta exacta, fecha y hash SHA-256."
                               Foreground="#64748B"
                               FontSize="12.5"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <ScrollViewer x:Name="PanelPreviewContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="INSPECTOR DE ARCHIVO" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />

                            <Border Background="#0B0F17" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Height="175" Margin="0,0,0,12">
                                <Grid>
                                    <Image x:Name="ImgPreview" Stretch="Uniform" Margin="6" Visibility="Collapsed" />
                                    <StackPanel x:Name="PanelNonImagePreview" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                                        <Border Background="#182235" BorderBrush="#2D3D58" BorderThickness="1" CornerRadius="8" Padding="16,10" HorizontalAlignment="Center">
                                            <TextBlock x:Name="TxtPreviewExt" Text=".FILE" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" />
                                        </Border>
                                        <TextBlock Text="Sin vista previa grafica" FontSize="11" Foreground="#64748B" Margin="0,8,0,0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TxtInspectorName" Text="" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,0,0,8" />

                            <TextBlock Text="Ruta completa" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                            <TextBox x:Name="TxtInspectorPath"
                                     IsReadOnly="True"
                                     Background="#0B0F17"
                                     Foreground="#CBD5E1"
                                     BorderBrush="#1E293B"
                                     BorderThickness="1"
                                     Padding="7,5"
                                     FontSize="11.5"
                                     TextWrapping="Wrap"
                                     Margin="0,3,0,10" />

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Tamano exacto" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtInspectorSize" Text="" FontSize="12" Foreground="#F8FAFC" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Accion actual" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtInspectorAction" Text="" FontSize="12" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="Modificado" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtInspectorModified" Text="" FontSize="11.5" Foreground="#CBD5E1" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Creado" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                                    <TextBlock x:Name="TxtInspectorCreated" Text="" FontSize="11.5" Foreground="#CBD5E1" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Hash SHA-256" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" />
                            <TextBox x:Name="TxtInspectorHash"
                                     IsReadOnly="True"
                                     Background="#0B0F17"
                                     Foreground="#94A3B8"
                                     BorderBrush="#1E293B"
                                     BorderThickness="1"
                                     Padding="7,5"
                                     FontFamily="Consolas"
                                     FontSize="10.5"
                                     TextWrapping="Wrap"
                                     Margin="0,3,0,12" />

                            <Button x:Name="BtnMarkFolderDuplicates" Style="{StaticResource SecondaryButtonStyle}" Content="Marcar duplicados de esta carpeta" Margin="0,0,0,6" />
                            <Button x:Name="BtnOpenLocation" Style="{StaticResource SecondaryButtonStyle}" Content="Abrir ubicacion en Explorador" Margin="0,0,0,6" />
                            <Button x:Name="BtnCopyHash" Style="{StaticResource SecondaryButtonStyle}" Content="Copiar SHA-256" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 5: Guardrails & Audit Footer -->
        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TxtGuardrailNotice"
                       Grid.Column="0"
                       Text="Guardrails activos: C:\Windows, Program Files, OneDrive offline y carpetas ocultas/sistema protegidas."
                       FontSize="11.5"
                       Foreground="#64748B"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TxtFooterAudit"
                       Grid.Column="1"
                       Text="Eliminacion segura mediante Papelera de Reciclaje"
                       FontSize="11.5"
                       Foreground="#64748B"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>

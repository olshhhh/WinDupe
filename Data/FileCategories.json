{
  "categories": {
    "All": {
      "label": "Todos",
      "extensions": []
    },
    "Images": {
      "label": "Imagenes",
      "extensions": [
        ".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp",
        ".heic", ".heif", ".tiff", ".tif", ".svg", ".ico",
        ".avif", ".raw", ".cr2", ".nef", ".arw", ".dng"
      ]
    },
    "Videos": {
      "label": "Videos",
      "extensions": [
        ".mp4", ".mkv", ".avi", ".mov", ".wmv", ".webm",
        ".flv", ".m4v", ".mpeg", ".mpg", ".3gp", ".ts"
      ]
    },
    "Documents": {
      "label": "Documentos",
      "extensions": [
        ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt",
        ".pptx", ".txt", ".md", ".csv", ".rtf", ".odt",
        ".ods", ".odp", ".epub", ".json", ".xml", ".log"
      ]
    },
    "Audio": {
      "label": "Audio",
      "extensions": [
        ".mp3", ".wav", ".flac", ".aac", ".ogg", ".m4a",
        ".wma", ".opus", ".aiff", ".alac", ".mid", ".midi"
      ]
    }
  },
  "previewableImageExtensions": [
    ".jpg", ".jpeg", ".png", ".bmp", ".gif", ".ico", ".tiff", ".tif"
  ],
  "blockedFolderNames": [
    "$recycle.bin",
    "system volume information",
    "windows",
    "winsxs",
    "recovery",
    "msocache",
    "perflogs",
    "$windows.~bt",
    "$windows.~ws",
    "config.msi"
  ]
}
